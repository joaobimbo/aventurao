// Room 10: estacao - ligacao entre casa, Universidade e Moinho Velho

bool despedidaPaiVista = false;

#define ESTACAO_GABRIEL_X 300
#define ESTACAO_LUIS_X 420
#define ESTACAO_PERSONAGENS_Y 500

function room_Load()
{
  hSolum.Enabled = gabinete_episodio_concluido;
  hHotspot2.Enabled = !gabinete_episodio_concluido;

  if (gabinete_episodio_concluido && !despedidaPaiVista)
  {
    player.x = ESTACAO_GABRIEL_X;
    player.y = ESTACAO_PERSONAGENS_Y;
    cLuis.ChangeRoom(10, ESTACAO_LUIS_X, ESTACAO_PERSONAGENS_Y);
  }
}

function room_AfterFadeIn()
{
  if (!gabinete_episodio_concluido || despedidaPaiVista) return;

  despedidaPaiVista = true;
  player.FaceCharacter(cLuis, eBlock);
  cLuis.FaceCharacter(player, eBlock);

  cLuis.Say("Agora vai buscar o bolo ao Moinho Velho.");
  cLuis.Say("Vou andando para casa...");
  player.Say("Ir buscar o meu proprio bolo. Um aniversario muito participativo.");

  cLuis.ChangeRoom(-1);
}

function hHotspot2_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (gabinete_episodio_concluido)
  {
    player.Say("Ja voltei da Universidade. Agora falta o bolo.");
    return;
  }

  player.ChangeRoom(3, 10, 550);
}

function hParaCasa_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(2, 10, 550);

}

function hSolum_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (!gabinete_episodio_concluido)
  {
    player.Say("Ainda tenho de ir buscar o Pai a Universidade.");
    return;
  }

  player.ChangeRoom(6, 80, 520);

}
