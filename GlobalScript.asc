  if (player.Room == 7) CallRoomScript(712);
}

bool check_popup_distance(int y)
{
  // popup when the cursor is in 3/4 of the iconbar area
  return y < FloatToInt(IntToFloat(gIconbar.Height) * 0.75, eRoundNearest);
}

// called on every game cycle, except when the game is blocked
function repeatedly_execute()
{
  gIconbar.Visible = false;
}

// called on every game cycle, even when the game is blocked
function repeatedly_execute_always()
{
  if (Screen.Width != last_screen_width || Screen.Height != last_screen_height)
  {
    last_screen_width = Screen.Width;
    last_screen_height = Screen.Height;
    update_iconbar_position();
  }
}

// called when a dialog script line "run-script" is processed
function dialog_request(int param)
{
  if (param == 20) praxistas_dialog_result = 20;
  else if (param == 73) cartazGregoResolvido = true;
  else if (param == 80) FlipHourglass(4);
  else if (param == 81) FlipHourglass(7);
  else if (param == 82) WaitForNextHourglass();
  else if (param == 83) RemoveTopping();
  else if (param == 95) BeginCakeAssignments();
  else if (param >= 100 && param <= 104) SubmitCakeOwner(param - 99);
}

// called when processclick wasn't handled anywhere else
function unhandled_event (int what, int type)
{
  if (what == 1) // Unhandled events for HOTSPOTS
  {
    if (type == 1) // look
    {
      player.Say("Nao parece especial. So um pouco suspeito.");
    }
    else if (type == 2) // interact
    {
      player.Say("Eu acho que isso ainda nao esta pronto para minhas maos de 9 anos.");
    }
    else if (type == 3) // use inv on
    {
      player.Say("Isso nao vai ajudar em nada.");
    }
    else if (type == 4) // talk to
    {
      player.Say("Se isso responder, eu vou embora correndo.");
    }
    else if (type == 7) // pick up
    {
      player.Say("Talvez eu nao deva carregar isso sem permissao.");
    }
  }
  else if (what == 2) // Unhandled events for OBJECTS
  {
    if (type == 0) // look
    {
      player.Say("Parece normal. Estranhamente normal.");
    }
    else if (type == 1) // interact
    {
      player.Say("Nao sei usar isso do jeito certo. Ainda.");
    }
    else if (type == 2) // talk to
    {
      player.Say("Esse objeto nao parece muito de conversa.");
    }
    else if (type == 3) // use inv on
    {
      player.Say("Ideia engracada. Ideia ruim.");
    }
    else if (type == 5) // pick up
    {
      player.Say("Eu topo pegar, mas so se ninguem estiver olhando.");
    }
  }
  else if (what == 3) // Unhandled events for CHARACTERS
  {
    if (type == 0) // look
    {
      player.Say("Hm. Esse ai parece importante.");
    }
    else if (type == 1) // interact
    {
      player.Say("Ei?");
    }
    else if (type == 2) // talk to
    {
      player.Say("Nao tenho nada de muito inteligente para dizer agora.");
    }
    else if (type == 3) // use inv on
    {
      player.Say("Nao vou entregar isso assim tao facil.");
    }
    else if (type == 5) // pick up
    {
      player.Say("Pegar pessoas nao e um bom plano.");
    }
  }
  else if (what == 5) // Unhandled events for INVENTORY ITEMS
  {
    if (type == 0) // look
    {
      player.Say("Aparentemente isso vai ficar no meu bolso por enquanto.");
    }
    else if (type == 1) // interact
    {
      player.Say("Acho que nao e assim que funciona.");
    }
    else if (type == 3) // use inv on
    {
      player.Say("Isso parece uma pessima ideia. Logo: talvez seja uma boa ideia.");
    }
  }
}

