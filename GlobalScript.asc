int hourglassElapsed = 0;
int glass4Remaining = 0;
int glass7Remaining = 0;
bool glass4Running = false;
bool glass7Running = false;

function ResetHourglassPuzzle()
{
  hourglassElapsed = 0;
  glass4Remaining = 0;
  glass7Remaining = 0;
  glass4Running = false;
  glass7Running = false;
  cakeInOven = false;
}
export ResetHourglassPuzzle;

function StartToppingIfReady()
{
  if (!cakeInOven && glass4Running && glass7Running)
  {
    cakeInOven = true;
    hourglassElapsed = 0;
    cPasteleiro.Say("As duas estao a correr. A cobertura entra no forno agora.");
  }
}

function ShowHourglassStatus()
{
  if (cakeInOven)
    Display("Cobertura no forno: %d minuto(s).\nAmpulheta 4: %d minuto(s).\nAmpulheta 7: %d minuto(s).", hourglassElapsed, glass4Remaining, glass7Remaining);
  else
    Display("A cobertura ainda nao entrou no forno.\nAmpulheta 4: %d minuto(s).\nAmpulheta 7: %d minuto(s).", glass4Remaining, glass7Remaining);
}
export ShowHourglassStatus;

function FlipHourglass(int duration)
{
  if (duration == 4)
  {
    if (glass4Running) glass4Remaining = 4 - glass4Remaining;
    else glass4Remaining = 4;
    glass4Running = (glass4Remaining > 0);
  }
  else
  {
    if (glass7Running) glass7Remaining = 7 - glass7Remaining;
    else glass7Remaining = 7;
    glass7Running = (glass7Remaining > 0);
  }
  StartToppingIfReady();
  ShowHourglassStatus();
}

function BurnToppingAndRestart()
{
  cPasteleiro.Say("...");
  cPasteleiro.Say("Passou do ponto. A cobertura adquiriu propriedades geologicas.");
  player.Say("Posso chamar-lhe crocante?");
  cPasteleiro.Say("Podes chamar-lhe tentativa anterior.");
  FadeOut(10);
  ResetHourglassPuzzle();
  FadeIn(10);
  Display("O chefe prepara uma nova cobertura. As ampulhetas voltam ao estado inicial.");
}

function WaitForNextHourglass()
{
  int delta = 0;

  if (glass4Running) delta = glass4Remaining;
  if (glass7Running && (delta == 0 || glass7Remaining < delta)) delta = glass7Remaining;

  if (delta == 0)
  {
    cPasteleiro.Say("Esperar por uma ampulheta parada e filosofia, nao pastelaria.");
    return;
  }

  if (glass4Running)
  {
    glass4Remaining -= delta;
    if (glass4Remaining == 0) glass4Running = false;
  }
  if (glass7Running)
  {
    glass7Remaining -= delta;
    if (glass7Remaining == 0) glass7Running = false;
  }

  if (cakeInOven) hourglassElapsed += delta;

  if (cakeInOven) cPasteleiro.Say("Ja passaram %d minutos de cozedura.", hourglassElapsed);
  else cPasteleiro.Say("Passaram %d minutos, mas a cobertura ainda nao entrou.", delta);

  if (cakeInOven && hourglassElapsed > 9)
  {
    BurnToppingAndRestart();
    return;
  }
  ShowHourglassStatus();
}

function RemoveTopping()
{
  if (!cakeInOven)
  {
    cPasteleiro.Say("Primeiro convinha meter a cobertura no forno.");
    return;
  }
  if (hourglassElapsed < 9)
  {
    cPasteleiro.Say("Ainda esta crua. Ate a colher se recusa a tocar-lhe.");
    return;
  }
  if (hourglassElapsed > 9)
  {
    BurnToppingAndRestart();
    return;
  }

  cPasteleiro.Say("Perfeita. Nove minutos exatos.");
  player.Say("Quatro, sete e varias voltas. A receita mais cansativa da casa.");
  ampulhetasResolvidas = true;
  cakeInOven = false;
  dAmpulhetas.Stop();

  FadeOut(20);
  CallRoomScript(700);
  FadeIn(20);

  dIntroducaoBolos.Start();
}

int cakeAssignmentStep = 0;
int cakeOwnerAnswers[5];

function ResetCakeAssignments()
{
  cakeAssignmentStep = 0;
  cakeOwnerAnswers[0] = 0;
  cakeOwnerAnswers[1] = 0;
  cakeOwnerAnswers[2] = 0;
  cakeOwnerAnswers[3] = 0;
  cakeOwnerAnswers[4] = 0;
}

function AskForNextCakeOwner()
{
  if (cakeAssignmentStep == 0) cPasteleiro.Say("Para quem e o bolo A?");
  else if (cakeAssignmentStep == 1) cPasteleiro.Say("Registado. Para quem e o bolo B?");
  else if (cakeAssignmentStep == 2) cPasteleiro.Say("Registado. Para quem e o bolo C?");
  else if (cakeAssignmentStep == 3) cPasteleiro.Say("Registado. Para quem e o bolo D?");
  else if (cakeAssignmentStep == 4) cPasteleiro.Say("Registado. Para quem e o bolo E?");
}

function BeginCakeAssignments()
{
  ResetCakeAssignments();
  cPasteleiro.Say("Quero as cinco atribuicoes. Cada nome e usado uma vez.");
  cPasteleiro.Say("Nao confirmo nenhuma resposta antes de receber a lista completa.");
  AskForNextCakeOwner();
}

function CompleteCakeAssignments()
{
  dEscolherBolo.Stop();
  boloIdentificado = true;
  cakePuzzleSolved = true;
  pastelariaConcluida = true;
  cPasteleiro.Say("Perfeito: A e da Mariana, B do Tiago, C da Rita, D do Gabriel e E da Patricia.");
  cPasteleiro.Say("O hexagonal, de caramelo e com estrelas, e o do Gabriel.");
  cPasteleiro.Say("Vou colocar a cobertura.");
  Display("O chefe termina o bolo e fecha-o cuidadosamente numa caixa.");
  if (player.InventoryQuantity[iBirthdayCake.ID] == 0) player.AddInventory(iBirthdayCake);

  cPasteleiro.Say("Nao es mau.");
  player.Say("Obrigado.");
  cPasteleiro.Say("Se continuares assim, daqui a uns anos ainda acabas engenheiro.");
  player.Say("Hoje preferia acabar aniversariante.");
  //Display("Gabriel regressa a casa com o bolo.");
  //FadeOut(20);
  //player.ChangeView(2);
  //player.ChangeRoom(2, 400, 420);
}

function SubmitCakeOwner(int ownerId)
{
  bool allCorrect = false;

  if (cakeAssignmentStep < 0 || cakeAssignmentStep > 4) return;

  cakeOwnerAnswers[cakeAssignmentStep] = ownerId;
  cakeAssignmentStep++;

  if (cakeAssignmentStep < 5)
  {
    AskForNextCakeOwner();
    return;
  }

  // IDs: 1=Gabriel, 2=Mariana, 3=Patricia, 4=Rita, 5=Tiago.
  allCorrect = cakeOwnerAnswers[0] == 2 &&
               cakeOwnerAnswers[1] == 5 &&
               cakeOwnerAnswers[2] == 4 &&
               cakeOwnerAnswers[3] == 1 &&
               cakeOwnerAnswers[4] == 3;

  if (allCorrect)
  {
    CompleteCakeAssignments();
    return;
  }

  cPasteleiro.Say("A lista nao fecha. Pelo menos uma atribuicao esta errada.");
  cPasteleiro.Say("Nao digo qual, nem quantas. Isso seria pastelaria assistida.");
  player.Say("E apaga as respostas todas, suponho.");
  cPasteleiro.Say("Com enorme satisfacao.");
  ResetCakeAssignments();
  cPasteleiro.Say("Voltamos ao principio.");
  AskForNextCakeOwner();
}

function SelectBirthdayCake(int cakeNumber)
{
  if (!ampulhetasResolvidas)
  {
    cPasteleiro.Say("Primeiro a cobertura. Um bolo sem cobertura e geometria seca.");
    return;
  }
  if (boloIdentificado) return;

  player.Say("Escolher apenas um bolo permitiria resolver isto por tentativa e erro.");
  cPasteleiro.Say("Exatamente. Fala comigo e entrega as cinco atribuicoes.");
}
export SelectBirthdayCake;

int last_screen_width = 0;
int last_screen_height = 0;

function update_iconbar_position()
{
  gIconbar.X = (Screen.Width - gIconbar.Width) / 2;
}

bool IsRoomOneBedClick(int x, int y)
{
  return player.Room == 1 && x >= 480 && x <= 795 && y >= 220 && y <= 430;
}

bool HandleRoomOneSpecialClick(int x, int y, CursorMode mode)
{
  if (mode != eModeInteract || !IsRoomOneBedClick(x, y))
  {
    return false;
  }

  player.Walk(560, 350, eBlock, eWalkableAreas);

  if (!gabriel_practiced_oboe)
  {
    player.Say("Se me deito agora, a minha mae ativa o modo chefe final.");
    return true;
  }

  player.Say("Agora sim. Cama.");
  player.ChangeRoom(2);
  return true;
}
export HandleRoomOneSpecialClick;

//=============================================================================
// INITIALIZATION
//=============================================================================

// set default game options
function set_default_options()
{
  System.Volume = 100;
  sldAudio.Value = System.Volume;
  sldSpeed.Value = 40;
  SetGameSpeed(40);

  if (IsSpeechVoxAvailable())
  {
     Speech.VoiceMode = eSpeechVoiceAndText;
     btnVoice.Text = "Voz e texto";
     sldVoice.Value = 255;
     SetSpeechVolume(255);
  }

  if (System.SupportsGammaControl)
  {
    System.Gamma = 100;
    sldGamma.Value = 100;
  }
}

// initialize gPanel
function initialize_control_panel()
{
  if (!IsSpeechVoxAvailable())
  {
    // hide the speech controls, if speech is not available
    lblVoice.Visible = false;
    btnVoice.Visible = false;
    sldVoice.Visible = false;
  }

  if (!System.SupportsGammaControl) {
    // hide the gamma control, if not supported
    sldGamma.Visible = false;
    lblGamma.Visible = false;
  }

  set_default_options();
}

// called when the game starts, before the first room is loaded
function game_start()
{
  // initialize gPanel controls
  initialize_control_panel();

  if (!intro_gabriel_shown)
  {
    intro_gabriel_shown = true;
    Display("Gabriel, 9 anos, acha que hoje vai ser um dia normal.\n\nSpoiler: nao vai ser.");
  }
  
  // Keep the top iconbar hidden; Escape opens the control panel.
  gIconbar.Visible = false;

  // center Iconbar
  update_iconbar_position();
  last_screen_width = Screen.Width;
  last_screen_height = Screen.Height;
  
  // setup VerbCoin GUI and buttons
  VerbCoin.InterfaceGui = gVerbCoin;
  VerbCoin.RegisterButton(btnLook, eVerbCoinPositionNorth, eModeLookat, "Olhar");
  VerbCoin.RegisterButton(btnTalk, eVerbCoinPositionEast, eModeTalkto, "Falar");
  VerbCoin.RegisterButton(btnInteract, eVerbCoinPositionSouth, eModeInteract, "Usar");
  VerbCoin.RegisterButton(btnPickup, eVerbCoinPositionWest, eModePickup, "Pegar");

  // select the inventory GUI and action label
  VerbCoin.InventoryGui = gInventory;
  VerbCoin.ActionLabel = lblAction;

  // disable buttons where click events would be unhandled
  //VerbCoin.ButtonAutoDisable = true;
  
  // don't show verb coin if a hotspot has none of the standard
  // interactions at all; in that case a default interaction will be
  // issued right away, possibly causing "unhandled_event".
  // this is simply to save player a bit of time,
  // useful in combination with ButtonAutoDisable.
  //VerbCoin.ShowOnlyIfInteractionAvailable = true;
  
  // The primary cursor mode in this template is Interact.
  // In this template this is mostly a formality, but this mode will
  // be used if ShowOnlyIfInteractionAvailable is enabled, and
  // a hotspot has none of the standard Verb Coin's interactions at all.
  VerbCoin.DefaultCursorMode = eModeInteract;

  // Auto-save on the save slot 999
  SetRestartPoint();
}

//=============================================================================
// Common GUI functions
//=============================================================================

// open a GUI
function open_gui(GUI* gui_to_open)
{
  VerbCoin.Close();
  VerbCoin.Disable();
  gIconbar.Visible = false;
  // Switch to the "pointer" cursor look temporarily, while gui is on
  mouse.UseModeGraphic(eModePointer);
  gui_to_open.Visible = true;
}

// hide a GUI
function close_gui(GUI* gui_to_close)
{
  gui_to_close.Visible = false;
  // Switch back to default cursor graphic
  mouse.UseDefaultGraphic();
  VerbCoin.Enable();
}

// hide a GUI, based on a GUI control
function close_owning_gui(GUIControl* control)
{
  close_gui(control.OwningGUI);
}

// hide a GUI directly from an OnClick event
function close_gui_onclick(GUIControl *control, MouseButton button)
{
  close_owning_gui(control);
}

function show_save_game_dialog()
{
  // get the list of save games
  lstSaveGamesList.FillSaveGameList();

  if (lstSaveGamesList.ItemCount > 0)
  {
    // if there is at least one, set the default text
    // to be the first game's name
    txtNewSaveName.Text = lstSaveGamesList.Items[0];
  }
  else
  {
    // no save games yet, so default to empty text
    txtNewSaveName.Text = "";
  }

  open_gui(gSaveGame);
}

function show_restore_game_dialog()
{
  lstRestoreGamesList.FillSaveGameList();
  open_gui(gRestoreGame);
}

