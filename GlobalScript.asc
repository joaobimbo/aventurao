function MontarReguaComFita()
{
  player.LoseInventory(iRegua);
  player.LoseInventory(iFitaCola);
  player.AddInventory(iReguaComFita);
  player.ActiveInventory = null;
  Display("Juntaste a fita-cola a regua. Agora tens tecnologia de ponta pegajosa.");
}

function EncherFrasco()
{
  player.LoseInventory(iFrasco);
  player.LoseInventory(iCopoAgua);
  player.AddInventory(iFrascoComAgua);
  player.ActiveInventory = null;
  Display("Deitaste a agua no frasco sem molhar nenhum exame. Milagre academico.");
}

function PrepararSuspensao()
{
  player.LoseInventory(iFrascoComAgua);
  player.LoseInventory(iPoEfervescente);
  player.AddInventory(iSuspensao);
  player.ActiveInventory = null;
  Display("Misturaste o po com a agua. As particulas ficam suspensas... durante algum tempo.");
}

function iFitaCola_UseInv(InventoryItem *theItem, CursorMode mode)
{
  if (player.ActiveInventory == iRegua)
    MontarReguaComFita();
  else
    player.Say("Fita-cola resolve muita coisa. Essa nao e uma delas.");
}

function iRegua_UseInv(InventoryItem *theItem, CursorMode mode)
{
  if (player.ActiveInventory == iFitaCola)
    MontarReguaComFita();
  else
    player.Say("Medir o problema nao o tornou menor.");
}

function iFrasco_UseInv(InventoryItem *theItem, CursorMode mode)
{
  if (player.ActiveInventory == iCopoAgua)
    EncherFrasco();
  else if (player.ActiveInventory == iPoEfervescente)
    player.Say("Se juntar o po primeiro, ele fica no fundo a planear coisas.");
  else
    player.Say("O frasco continua vazio. Muito profissional, pouco util.");
}

function iCopoAgua_UseInv(InventoryItem *theItem, CursorMode mode)
{
  if (player.ActiveInventory == iFrasco)
    EncherFrasco();
  else
    player.Say("Nao vou regar isso. Nem sequer parece uma planta.");
}

function iFrascoComAgua_UseInv(InventoryItem *theItem, CursorMode mode)
{
  if (player.ActiveInventory == iPoEfervescente)
    PrepararSuspensao();
  else
    player.Say("Agua num frasco. A ciencia esta quase a acontecer.");
}

function iPoEfervescente_UseInv(InventoryItem *theItem, CursorMode mode)
{
  if (player.ActiveInventory == iFrascoComAgua)
    PrepararSuspensao();
  else if (player.ActiveInventory == iFrasco)
    player.Say("Primeiro preciso de por agua no frasco.");
  else
    player.Say("Espalhar po misterioso pela universidade parece uma forma rapida de conhecer a seguranca.");
}

function iReguaComFita_Interact(InventoryItem *theItem, CursorMode mode)
{
  player.Say("Uma regua com fita-cola na ponta. Engenharia de nove anos, aprovada por mim.");
}

function iRascunho_Interact(InventoryItem *theItem, CursorMode mode)
{
  player.Say("A letra parece uma aranha a fugir de outra aranha.");
}

function iGrelhaCorrecao_Interact(InventoryItem *theItem, CursorMode mode)
{
  player.Say("Uma pagina da grelha. Tem um frasco, agua e pontinhos que se recusam a desaparecer.");
}

function iSuspensao_Interact(InventoryItem *theItem, CursorMode mode)
{
  player.Say("As particulas estao na agua, mas nao dissolvidas. Ate eu percebi esta.");
}

function iChavesLuis_Interact(InventoryItem *theItem, CursorMode mode)
{
  player.Say("As chaves do Pai. O verdadeiro diploma de quem quer sair do gabinete.");
}

function FalarComLuis()
{
  if (player.Room != 4) return;

  player.Walk(cLuis.x - 80, cLuis.y, eBlock, eWalkableAreas);
  player.FaceCharacter(cLuis, eBlock);
  cLuis.FaceCharacter(player, eBlock);

  if (!gabinete_problema_explicado)
  {
    player.Say("Pai, a Mae disse que tens de vir comigo.");
    cLuis.Say("Vou, Gabriel. So me falta corrigir este ultimo exame.");
    cLuis.Say("O problema e que esta resposta parece escrita por um eletrocardiografo assustado.");
    player.Say("E nao podes marcar errado?");
    cLuis.Say("Posso marcar errado quando percebo que esta errado. Isto pode ser ciencia. Ou um pedido de socorro.");
    cLuis.Say("O aluno deixou cair um rascunho debaixo daquele armario. Se o recuperasse, talvez ajudasse.");
    gabinete_problema_explicado = true;
    return;
  }

  if (!gabinete_rascunho_encontrado)
  {
    cLuis.Say("O rascunho esta debaixo do armario. Eu tentei alcanca-lo com dignidade, mas a dignidade era curta.");
    player.Say("Vou procurar uma coisa comprida. E outra pegajosa. Isto soa pior do que devia.");
    return;
  }

  if (!gabinete_grelha_encontrada)
  {
    cLuis.Say("No rascunho consigo ler 'pagina quarenta e sete'.");
    cLuis.Say("A pagina correspondente da grelha deve estar metida num dos livros da estante.");
    player.Say("Uma pagina escondida dentro de outras paginas. Astuto.");
    return;
  }

  if (!gabinete_resposta_resolvida)
  {
    cLuis.Say("A grelha mostra agua, um po e particulas que ficam espalhadas no liquido.");
    cLuis.Say("Se conseguirmos demonstrar o que acontece, talvez a palavra do aluno se torne obvia.");
    player.Say("Finalmente um problema escolar resolvido a misturar coisas.");
    return;
  }

  if (!gabinete_chaves_encontradas)
  {
    if (!gabinete_chaves_mencionadas)
    {
      cLuis.Say("Acabei! Agora so preciso das minhas chaves.");
      player.Say("Quando foi a ultima vez que as viste?");
      cLuis.Say("Antes de comecar a corrigir. Devem estar algures na secretaria.");
      player.Say("Vou procurar. Se encontrar outro exame, finjo que nao vi.");
      gabinete_chaves_mencionadas = true;
    }
    else
      cLuis.Say("As chaves devem estar na secretaria, algures debaixo desta pequena cordilheira de exames.");
    return;
  }

  if (!gabinete_episodio_concluido)
  {
    player.LoseInventory(iChavesLuis);
    player.ActiveInventory = null;
    cLuis.Say("Resposta identificada, exames corrigidos e chaves recuperadas.");
    player.Say("Isso da quanto valores?");
    cLuis.Say("Da direito a sairmos daqui antes que apareca outro exame.");
    gabinete_episodio_concluido = true;
    player.ChangeRoom(6, 80, 520);
  }
}

function cLuis_Look(Character *theCharacter, CursorMode mode)
{
  if (gabinete_resposta_resolvida)
    player.Say("O Pai parece aliviado. Ou deixou de conseguir sentir a cara.");
  else
    player.Say("O Pai corrige exames com a expressao de quem encontrou um novo tipo de dor de cabeca.");
}

function cLuis_Talk(Character *theCharacter, CursorMode mode)
{
  FalarComLuis();
}

function cLuis_Interact(Character *theCharacter, CursorMode mode)
{
  FalarComLuis();
}

function cLuis_UseInv(Character *theCharacter, CursorMode mode)
{
  if (player.Room != 4) return;

  if (player.ActiveInventory == iRascunho)
  {
    cLuis.Say("Sim! Aqui diz 'pagina quarenta e sete'. Procura essa pagina na estante.");
    return;
  }

  if (player.ActiveInventory == iGrelhaCorrecao)
  {
    cLuis.Say("Esta e a pagina certa: agua, po e particulas espalhadas. Falta dar um nome ao resultado.");
    return;
  }

  if (player.ActiveInventory == iSuspensao)
  {
    if (!gabinete_rascunho_encontrado || !gabinete_grelha_encontrada)
    {
      cLuis.Say("E uma boa demonstracao, mas ainda precisamos das pistas do exame.");
      return;
    }

    if (!gabinete_resposta_resolvida)
    {
      player.Say("O po nao desapareceu. Ficou espalhado na agua e depois comecou a assentar.");
      cLuis.Say("Exatamente. Uma suspensao oral!");
      player.Say("Entao a palavra do aluno era 'suspensao'?");
      cLuis.Say("Era. Escrita como se a propria caneta estivesse em suspensao.");
      cLuis.Say("Posso finalmente corrigir a resposta.");
      player.LoseInventory(iSuspensao);
      player.ActiveInventory = null;
      gabinete_resposta_resolvida = true;
      Display("O ultimo exame foi corrigido.");
    }
    else
      cLuis.Say("Ja demonstraste o conceito. Nao precisamos de fundar uma farmacia no gabinete.");
    return;
  }

  if (player.ActiveInventory == iChavesLuis)
  {
    player.Say("Encontrei as tuas chaves.");
    FalarComLuis();
    return;
  }

  player.Say("O Pai ja tem objetos suficientes em cima da secretaria.");
}

