function VestirSacoComoVeterano()
{
  if (praxe_state != 1 || player.InventoryQuantity[iSacoLixo.ID] == 0)
  {
    player.Say("Ja fiz tudo o que conseguia fazer com este saco.");
    return;
  }

  player.Say("Com dois buracos e muita confianca, isto quase parece uma capa de veterano.");
  player.LoseInventory(iSacoLixo);
  player.ActiveInventory = null;
  player.ChangeView(VIEWGABRIELSACO);
  praxe_state = 2;
  player.Say("Nunca pensei que um saco do lixo pudesse parecer tao academico.");
}

function iSacoLixo_Interact(InventoryItem *theItem, CursorMode mode)
{
  VestirSacoComoVeterano();
}

function cGabriel_UseInv(Character *theCharacter, CursorMode mode)
{
  if (player.ActiveInventory == iSacoLixo)
  {
    VestirSacoComoVeterano();
    return;
  }

  player.Say("Nao preciso de usar isso em mim.");
}

function FalarComGrupoPraxistas()
{
  if (player.Room != 3) return;

  player.Walk(430, 470, eBlock, eWalkableAreas);
  player.FaceCharacter(cPraxistas, eBlock);

  if (praxe_state < 2)
  {
    if (!dialogo_praxistas_inicial_visto)
    {
      cPraxistas.Say("Alto!");
      player.Say("Queria apenas entrar.");
      cPraxistas.Say("Caloiros nao entram.");
      cPraxistas.Say("Codigo da Praxe, artigo 8-A: um caloiro nao pode atravessar a Porta Ferrea durante o dia nos meses acabados em -eiro.");
      cPraxistas.Say("Durante a noite tambem nao, por causa do artigo 8-A-Noite.");
      player.Say("Nem sou estudante.");
      cPraxistas.Say("Isso e exatamente o que um caloiro diria.");
      dialogo_praxistas_inicial_visto = true;
    }
    dPraxistasAntes.Start();
  }
  else if (praxe_state == 2)
  {
    cPraxistas.Say("...Boa tarde, Doutor.");
    dPraxistasDobra.Start();
  }
  else
  {
    player.Say("Agora ficou pior.");
    cPraxistas.Say("Nao, esta e a dobra de Aveiro.");
    cPraxistas.Say("Isso existe?");
    cPraxistas.Say("Espero bem que nao.");
  }
}

function cPraxistas_Look(Character *theCharacter, CursorMode mode)
{
  player.Say("Cinco praxistas muito juntos. Parecem uma unica criatura academica.");
}

function cPraxistas_Interact(Character *theCharacter, CursorMode mode)
{
  FalarComGrupoPraxistas();
}

function cPraxistas_Talk(Character *theCharacter, CursorMode mode)
{
  FalarComGrupoPraxistas();
}

