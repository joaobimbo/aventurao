// Room 3: Porta Ferrea - puzzle do lixo e dos praxistas

int itens_no_caixote = 0;
bool cartazes_apanhados = false;
bool copos_apanhados = false;
bool cartazes_no_caixote = false;
bool copos_no_caixote = false;
bool dialogo_inicial_visto = false;
bool lixo_recolhido = false;

function AtualizarCaixote()
{
  // Dois objetos sobrepostos permitem trocar o estado sem depender de slots fixos.
  bool mostrar_cheio = (itens_no_caixote >= 2 && !lixo_recolhido);
  oLixo.Visible = !mostrar_cheio;
  oCaixote.Visible = mostrar_cheio;
}

function ChamarFuncionaria()
{
  cFuncionaria.ManualScaling = true;
  cFuncionaria.Scaling = 80;

  cFuncionaria.ChangeRoom(3, 0, 550);
  //cFuncionaria.FaceCharacter(cPraxistas, eBlock);
  cFuncionaria.Walk(150, 550, eBlock, eAnywhere);
  cFuncionaria.Say("Entao hoje nao ha aulas, e'?");
  cFuncionaria.Say("Nao me digam que ainda estao com os ''vapores'' da Queima das Fitas?");
  cFuncionaria.Walk(10, 550, eBlock, eAnywhere);

  
  // O loop 3 da ViewFuncionaria e a animacao de costas a trocar o saco.
  if (Game.GetFrameCountForLoop(cFuncionaria.View, 3) > 0)
  {
    
    cFuncionaria.Scaling = 85;
    cFuncionaria.Animate(3, 30, eOnce, eBlock, eForwards);
  }
  else
  {
    Display("A funcionaria retira o saco cheio e coloca um saco preto novo.");
  }

  lixo_recolhido = true;
  AtualizarCaixote();
  oSacoLimpo.Visible = true;
  cFuncionaria.Walk(0, 430, eBlock, eWalkableAreas);
  cFuncionaria.ChangeRoom(-1);
}

function DeitarItemNoCaixote(InventoryItem *item)
{
  player.LoseInventory(item);
  player.ActiveInventory = null;
  itens_no_caixote++;
  AtualizarCaixote();

  if (itens_no_caixote >= 2)
  {
    player.Walk(300, 550, eBlock, eWalkableAreas);
    ChamarFuncionaria();
  }
  else
  {
    player.Say("Ainda cabe mais qualquer coisa.");
  }
}

function room_Load()
{
  oSacoLimpo.Visible = (itens_no_caixote >= 2 && praxe_state == 0);
  AtualizarCaixote();
  cGabriel.PlaceOnWalkableArea();
  
  cPraxistas.ManualScaling = true;
  cPraxistas.Scaling = 80;
  cPraxistas.SpeechView=8;
  cPraxistas.SpeechAnimationDelay = 10;

  if (praxe_state == 3)
  {
    cPraxistas.Transparency = 100;
    cPraxistas.Clickable = false;
    hPraxistas.Enabled = false;
  }

}

function room_AfterFadeIn(){
  cGabriel.Walk(300, 550, eNoBlock, eAnywhere);
}

function room_RepExec()
{
  if (praxistas_dialog_result == 20 && praxe_state == 2)
  {
    praxistas_dialog_result = 0;
    cPraxistas.Say("Rapido! Vamos reaprender isto antes que alguem veja!");
    hPraxistas.Enabled = false;
    cPraxistas.Clickable = false;
    
    cPraxistas.ManualScaling = true;
    cPraxistas.Scaling = 40;

    //cPraxistas.Animate(3,  4, eRepeat, eNoBlock, eForwards);
    
    cPraxistas.Walk(850, cPraxistas.y, eBlock, eAnywhere);
    cPraxistas.Transparency = 100;
    praxe_state = 3;
    player.Say("Cinco estudantes, uma unica opiniao... e saiu toda pela direita.");
  }
}

function hCartazes_Look(Hotspot *theHotspot, CursorMode mode)
{
  if (cartazes_apanhados)
    player.Say("Ficaram as marcas de fita-cola. A Queima deixa sempre recordacoes.");
  else
    player.Say("Cartazes da Queima das Fitas 2026. Coloridos, insistentes e muito reciclaveis.");
}

function hCartazes_PickUp(Hotspot *theHotspot, CursorMode mode)
{
  if (cartazes_apanhados)
  {
    player.Say("Ja arranquei os que estavam soltos.");
    return;
  }
  
  oCartazes.Visible = false;
  player.Walk(theHotspot.WalkToX, theHotspot.WalkToY, eBlock, eWalkableAreas);
  cartazes_apanhados = true;
  player.AddInventory(iFolhetos);
  Display("Apanhaste os cartazes da Queima 2026.");
}

function oCopos_Look(Object *theObject, CursorMode mode)
{
  player.Say("Copos usados. Alguem festejou e deixou a parte menos divertida.");
}

function oCopos_PickUp(Object *theObject, CursorMode mode)
{
  if (copos_apanhados) return;

  player.Walk(theObject.X, theObject.Y, eBlock, eWalkableAreas);
  copos_apanhados = true;
  theObject.Visible = false;
  player.AddInventory(iCopos);
  Display("Apanhaste os copos usados.");
}

function hCaixote_Look(Hotspot *theHotspot, CursorMode mode)
{
  if (itens_no_caixote == 0)
    player.Say("Nem para justificar mudar o saco serve.");
  else if (itens_no_caixote == 1)
    player.Say("Quase cheio. Falta aquele ultimo empurraozinho ecologico.");
  else
    player.Say("Agora sim. Um monumento ao civismo de ultima hora.");
}

function hCaixote_UseInv(Hotspot *theHotspot, CursorMode mode)
{
  if (player.ActiveInventory == iFolhetos && !cartazes_no_caixote)
  {
    cartazes_no_caixote = true;
    DeitarItemNoCaixote(iFolhetos);
  }
  else if (player.ActiveInventory == iCopos && !copos_no_caixote)
  {
    copos_no_caixote = true;
    DeitarItemNoCaixote(iCopos);
  }
  else
  {
    player.Say("Isso nao pertence ao caixote. Pelo menos ainda.");
  }
}

// O hotspot criado no editor chama-se hLixo. Estes wrappers ligam-no a logica.
function hLixo_Look(Hotspot *theHotspot, CursorMode mode)
{
  hCaixote_Look(theHotspot, mode);
}

function hLixo_UseInv(Hotspot *theHotspot, CursorMode mode)
{
  hCaixote_UseInv(theHotspot, mode);
}

// O VerbCoin pode atingir diretamente qualquer um dos dois objetos sobrepostos.
function oLixo_Look(Object *theObject, CursorMode mode)
{
  hCaixote_Look(hLixo, mode);
}

function oLixo_UseInv(Object *theObject, CursorMode mode)
{
  hCaixote_UseInv(hLixo, mode);
}

function oCaixote_Look(Object *theObject, CursorMode mode)
{
  hCaixote_Look(hLixo, mode);
}

function oCaixote_UseInv(Object *theObject, CursorMode mode)
{
  hCaixote_UseInv(hLixo, mode);
}

function oSacoLimpo_Look(Object *theObject, CursorMode mode)
{
  player.Say("Saco do lixo limpo.");
}

function oSacoLimpo_PickUp(Object *theObject, CursorMode mode)
{
  if (praxe_state != 0)
  {
    player.Say("Ja tenho um saco com uma missao academica muito especifica.");
    return;
  }

  player.Walk(theObject.X, theObject.Y, eBlock, eWalkableAreas);
  theObject.Visible = false;
  player.AddInventory(iSacoLixo);
  praxe_state = 1;
  Display("Apanhaste o saco do lixo limpo.");
}

function hPraxistas_Look(Hotspot *theHotspot, CursorMode mode)
{
  if (praxe_state == 3)
    player.Say("Ao fundo, cinco pessoas tentam dobrar quatro capas ao mesmo tempo.");
  else
    player.Say("Cinco praxistas muito juntos. Parecem uma unica criatura academica.");
}

function FalarComPraxistas()
{
  player.Walk(130, 550, eBlock, eWalkableAreas);
  //player.FaceCharacter(cPraxistas, eBlock);
  
  //cPraxistas.Animate(3,1, eRepeat, eNoBlock, eForwards); 

  if (praxe_state < 2)
  {
    if (!dialogo_inicial_visto)
    {
      cPraxistas.Say("Alto!");
      player.Say("Queria apenas entrar.");
      cPraxistas.Say("Caloiros nao entram.");
      cPraxistas.Say("Codigo da Praxe, artigo 8-A: um caloiro nao pode atravessar a Porta Ferrea durante o dia nos meses acabados em -eiro.");
      cPraxistas.Say("Durante a noite tambem nao, por causa do artigo 8-A-Noite.");
      player.Say("Nem sou estudante.");
      cPraxistas.Say("Isso e exatamente o que um caloiro diria.");
      dialogo_inicial_visto = true;
    }

    dPraxistasAntes.Start();
    return;
  }

  if (praxe_state == 2)
  {
    cPraxistas.Say("...Boa tarde, Doutor.");
    dPraxistasDobra.Start();
    return;
  }

  player.Say("Agora ficou pior.");
  cPraxistas.Say("Nao, esta e a dobra de Aveiro.");
  cPraxistas.Say("Isso existe?");
  cPraxistas.Say("Espero bem que nao.");
}

function hPraxistas_Talk(Hotspot *theHotspot, CursorMode mode)
{
  FalarComPraxistas();
}

function hPraxistas_Interact(Hotspot *theHotspot, CursorMode mode)
{
  FalarComPraxistas();
}

function hPortaFerrea_Look(Hotspot *theHotspot, CursorMode mode)
{
  if (praxe_state == 3)
    player.Say("Parece que a tradicao acabou de tirar um intervalo.");
  else
    player.Say("A Porta Ferrea. O caminho para o ir ter com o meu pai, com cinco problemas a frente.");
}

function hPortaFerrea_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.Walk(520, 550, eBlock, eWalkableAreas);

  if (praxe_state == 3)
  {
    player.ChangeRoom(4);
    return;
  }

  cPraxistas.Say("Olha um caloiro corajoso.");
  player.Walk(430, 470, eBlock, eWalkableAreas);
}


function hPortaFerrea_PickUp(Hotspot *theHotspot, CursorMode mode)
{
    player.Say("Nao vou pegar isto...");

}
