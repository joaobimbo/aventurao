// room script file

function Resize(Object *o, int scale){
  o.ManualScaling = true;
  o.Scaling=scale;
  
}


function room_Load()
{
  cGabriel.ChangeView(2);
  cGabriel.Loop = 0; // Frente / virado para a camara.
  cFamilia.ManualScaling = true;
  cFamilia.Scaling = 36;
  cFamilia.x=440;
  cFamilia.y=480;
  cGabriel.x=400;
  cGabriel.y=460;
  cGabriel.Baseline=550;
  
  Resize(oBolo, 40);
  Resize(oMug, 200);
  Resize(oCopo, 60);
  Resize(oCopo2, 60);
}


function room_AfterFadeIn()
{
  cFamilia.Say("Parabens a voce...");
  cFamilia.Say("... nesta data querida ...");
  cFamilia.Say("... muitas felicidades ...");
  cFamilia.Say("... muitos anos de vida ...");
  cFamilia.Say("Hoje e' dia de festa ...");
  cFamilia.Say("... cantam  as nossas almas ...");
  cFamilia.Say("... Parabens ao GABRIEL ...");
  cFamilia.Say("...  Uma salva de palmas!");
  cFamilia.Animate(0, 5, eRepeat);

}
