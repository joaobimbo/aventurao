// Room 4: gabinete do Luis - O Exame Impossivel

bool po_revelado = false;
bool chaves_reveladas = false;
bool regua_recolhida = false;
bool fita_recolhida = false;
bool frasco_recolhido = false;
bool po_recolhido = false;
bool copo_recolhido = false;
bool comPai = true;

bool TemItem(InventoryItem *item)
{
  return (player.InventoryQuantity[item.ID] > 0);
}

function AtualizarGabinete()
{
  oRegua.Visible = !regua_recolhida;
  oFitaCola.Visible = !fita_recolhida;
  oFrasco.Visible = !frasco_recolhido;
  oPoEfervescente.Visible = po_revelado && !po_recolhido;
  oCopoAgua.Visible = !copo_recolhido;
  oChaves.Visible = chaves_reveladas && !gabinete_chaves_encontradas;
}

function RecuperarEstadoDosObjetos()
{
  // Suporta entradas repetidas na sala e jogos guardados durante o puzzle.
  if (TemItem(iRegua) || TemItem(iReguaComFita) || gabinete_rascunho_encontrado)
    regua_recolhida = true;
  if (TemItem(iFitaCola) || TemItem(iReguaComFita) || gabinete_rascunho_encontrado)
    fita_recolhida = true;
  if (TemItem(iFrasco) || TemItem(iFrascoComAgua) || TemItem(iSuspensao) || gabinete_resposta_resolvida)
    frasco_recolhido = true;
  if (TemItem(iCopoAgua) || TemItem(iFrascoComAgua) || TemItem(iSuspensao) || gabinete_resposta_resolvida)
    copo_recolhido = true;
  if (TemItem(iPoEfervescente) || TemItem(iSuspensao) || gabinete_resposta_resolvida)
  {
    po_revelado = true;
    po_recolhido = true;
  }
}

function ApanharItemDoGabinete(Object *objeto, InventoryItem *item, String mensagem)
{
  player.Walk(objeto.X, objeto.Y, eBlock, eWalkableAreas);
  objeto.Visible = false;
  player.AddInventory(item);
  Display(mensagem);
}

function ResizeObject(Object *o,  int scale){
  o.ManualScaling = true;
  o.Scaling = scale;
}


function room_Load()
{
  cLuis.ChangeRoom(4, 320, 420);
  cLuis.ManualScaling = true;
  cLuis.Scaling = 100;
  cLuis.SpeechAnimationDelay = 6;
  RecuperarEstadoDosObjetos();
  AtualizarGabinete();
  player.PlaceOnWalkableArea();

  ResizeObject(oPoEfervescente, 50);

  ResizeObject(oFitaCola, 50);
  ResizeObject(oRegua, 80);
  ResizeObject(oCopoAgua, 50);
  ResizeObject(oFrasco, 60);
  ResizeObject(oChaves, 50);
}

function room_AfterFadeIn()
{
  if (!gabinete_introducao_vista)
  {
    player.Say("Encontrei o Pai. Esta soterrado em exames, mas ainda respira.");
    cLuis.Say("Gabriel? Entra, mas nao toques em nada que tenha mais silabas do que tu.");
    gabinete_introducao_vista = true;
  }
}

function room_RepExec()
{
  // A visibilidade e alterada apenas por recolhas e revelacoes.
  // Nao recalcular aqui: itens consumidos poderiam reaparecer.
}

function hArmarioBaixo_Look(Hotspot *theHotspot, CursorMode mode)
{
  if (gabinete_grelha_encontrada && !po_revelado && !TemItem(iPoEfervescente) && !TemItem(iSuspensao))
    player.Say("O rascunho ja saiu de baixo. A grelha sugere que agora devo procurar dentro do armario.");
  else if (gabinete_rascunho_encontrado)
    player.Say("Debaixo do armario ficou apenas po. Nao parece do tipo farmaceutico.");
  else
    player.Say("Ha uma folha la no fundo. O meu braco ainda nao recebeu a atualizacao extensivel.");
}

function hArmarioBaixo_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (!gabinete_problema_explicado)
  {
    player.Say("Ha uma folha debaixo do armario, mas ainda nao sei se posso mexer nela.");
    return;
  }

  if (!gabinete_rascunho_encontrado)
  {
    player.Say("Nao chego la com a mao. Preciso de prolongar a minha influencia.");
    return;
  }

  if (!gabinete_grelha_encontrada)
  {
    player.Say("Ja recuperei o rascunho. Dentro do armario ha material de demonstracao, mas ainda nao sei do que preciso.");
    return;
  }

  if (!po_revelado && !TemItem(iPoEfervescente) && !TemItem(iSuspensao))
  {
    po_revelado = true;
    oPoEfervescente.Visible = true;
    Display("Abriste o armario e encontraste uma saqueta de po para demonstracoes.");
    player.Say("Po, agua e um frasco. A receita esta a ficar demasiado literal.");
    return;
  }

  player.Say("O armario ja nao tem mais nada util. Apenas coisas com nomes muito compridos.");
}

function hArmarioBaixo_UseInv(Hotspot *theHotspot, CursorMode mode)
{
  if (gabinete_rascunho_encontrado)
  {
    player.Say("O armario ja entregou o seu segredo.");
    return;
  }

  if (player.ActiveInventory != iReguaComFita)
  {
    player.Say("Isso nao chega a folha e, mais importante, nao cola.");
    return;
  }

  player.LoseInventory(iReguaComFita);
  player.ActiveInventory = null;
  player.AddInventory(iRascunho);
  gabinete_rascunho_encontrado = true;
  player.Walk(theHotspot.WalkToX, theHotspot.WalkToY, eBlock, eWalkableAreas);
  Display("Pescaste o rascunho com a regua pegajosa.");
  player.Say("A caligrafia continua ilegal, mas vejo o numero 47.");
}

function hEstante_Look(Hotspot *theHotspot, CursorMode mode)
{
  player.Say("Livros de farmacia. Todos grossos o suficiente para tratar uma mesa manca.");
}

function hEstante_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (!gabinete_rascunho_encontrado)
  {
    player.Say("Ha centenas de paginas. Preciso de uma pista menos enciclopedica.");
    return;
  }

  if (gabinete_grelha_encontrada)
  {
    player.Say("Ja encontrei a pagina quarenta e sete. As outras podem continuar a estudar.");
    return;
  }

  player.AddInventory(iGrelhaCorrecao);
  gabinete_grelha_encontrada = true;
  Display("Encontraste a pagina 47 da grelha de correcao.");
  player.Say("Um frasco, agua, po e muitos pontinhos. Isto ja parece um plano.");
}

function oRegua_Look(Object *theObject, CursorMode mode)
{
  player.Say("Uma regua comprida. Finalmente, a matematica torna-se fisicamente util.");
}

function oRegua_PickUp(Object *theObject, CursorMode mode)
{
  regua_recolhida = true;
  ApanharItemDoGabinete(theObject, iRegua, "Apanhaste a regua.");
}

function oFitaCola_Look(Object *theObject, CursorMode mode)
{
  player.Say("Fita-cola transparente. Torna as ideias mas pegajosas, nao mais inteligentes.");
}

function oFitaCola_PickUp(Object *theObject, CursorMode mode)
{
  fita_recolhida = true;
  ApanharItemDoGabinete(theObject, iFitaCola, "Apanhaste a fita-cola.");
}

function oFrasco_Look(Object *theObject, CursorMode mode)
{
  player.Say("Um frasco vazio. Tem aspeto cientifico e conteudo dececionante.");
}

function oFrasco_PickUp(Object *theObject, CursorMode mode)
{
  frasco_recolhido = true;
  ApanharItemDoGabinete(theObject, iFrasco, "Apanhaste o frasco vazio.");
}

function oPoEfervescente_Look(Object *theObject, CursorMode mode)
{
  player.Say("Uma saqueta para demonstracoes. Diz que nao e medicamento e que nao se come.");
}

function oPoEfervescente_PickUp(Object *theObject, CursorMode mode)
{
  po_recolhido = true;
  ApanharItemDoGabinete(theObject, iPoEfervescente, "Apanhaste a saqueta de po para demonstracoes.");
}

function oCopoAgua_Look(Object *theObject, CursorMode mode)
{
  player.Say("Um copo de agua. O objeto menos suspeito de todo o laboratorio.");
}

function oCopoAgua_PickUp(Object *theObject, CursorMode mode)
{
  copo_recolhido = true;
  ApanharItemDoGabinete(theObject, iCopoAgua, "Apanhaste o copo com agua.");
}

function oChaves_Look(Object *theObject, CursorMode mode)
{
  player.Say("As chaves do Pai, esmagadas pela educacao superior.");
}

function oChaves_PickUp(Object *theObject, CursorMode mode)
{
  if (!chaves_reveladas)
  {
    player.Say("Ainda nao encontrei as chaves.");
    return;
  }

  ApanharItemDoGabinete(theObject, iChavesLuis, "Apanhaste as chaves.");
  gabinete_chaves_encontradas = true;
}

function hPilhaExames_Look(Hotspot *theHotspot, CursorMode mode)
{
  if (chaves_reveladas && !gabinete_chaves_encontradas)
    player.Say("Depois de afastar os exames, vejo as chaves do Pai.");
  else if (gabinete_resposta_resolvida)
    player.Say("Exames corrigidos. Uma pequena montanha de conhecimento avaliado.");
  else
    player.Say("Exames por corrigir. Cada folha contem perguntas e uma quantidade variavel de panico.");
}

function hJanela_Look(Hotspot *theHotspot, CursorMode mode)
{
  player.Say("A janela esta fechada. Desta vez nenhuma grelha vai fugir com o vento.");
}

function hDiplomas_Look(Hotspot *theHotspot, CursorMode mode)
{
  player.Say("Diplomas do Pai. Provas oficiais de que ele estudou muito para corrigir papeis ate tarde.");
}

function hBancada_Look(Hotspot *theHotspot, CursorMode mode)
{
  player.Say("Uma bancada de demonstracoes. Aqui as coisas borbulham com autorizacao.");
}

function hPortaGabinete_Look(Hotspot *theHotspot, CursorMode mode)
{
  player.Say("A saida. O Pai esta a poucos exames de distancia.");
}

function hPortaGabinete_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (gabinete_episodio_concluido)
  {
    comPai = true;
    cLuis.ChangeRoom(5, 180, 520);
    player.ChangeRoom(5, 80, 520);
    return;
  }

  if (gabinete_resposta_resolvida && gabinete_chaves_encontradas)
  {
    FalarComLuis();
    return;
  }

  player.Say("Nao vou embora sem o Pai. Foi uma ordem da Mae, que e a forma domestica da lei.");
}

function hPilhaExames_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (!gabinete_chaves_mencionadas)
  {
    player.Say("Nao vou desarrumar os exames do Pai sem uma razao. Uma razao maior do que curiosidade.");
    return;
  }

  if (gabinete_chaves_encontradas)
  {
    player.Say("Ja tirei as chaves daqui. Os exames voltaram a dominar a secretaria.");
    return;
  }

  if (!chaves_reveladas)
  {
    chaves_reveladas = true;
    oChaves.Visible = true;
    Display("Afastaste a pilha de exames e encontraste as chaves do Pai.");
    player.Say("Estavam debaixo da educacao superior.");
    return;
  }

  player.Say("As chaves estao mesmo ali. Agora so falta pega-las.");
}
