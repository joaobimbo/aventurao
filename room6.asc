// Room 6: entrada da pastelaria

bool introducaoVista = false;
bool bancoAlinhado = false;
bool temAvental = false;
bool temChapeu = false;
bool empregadaDeixouPassar = false;

// Posicao final do banco sob o avental. Afinar no editor depois do teste.
#define BANCO_DESTINO_X 680
#define BANCO_DESTINO_Y 500

bool EstaDisfarcado()
{
  return temAvental && temChapeu;
}

function AtualizarEmpregada()
{
  cEmpregadaPastelaria.ChangeRoom(6, 350, 505);
  cEmpregadaPastelaria.ManualScaling = true;
  cEmpregadaPastelaria.Scaling = 90;
}

function TentarEntrarNaCozinha()
{
  if (pastelariaConcluida)
  {
    player.Say("Ja tenho o bolo. Voltar a cozinha seria pedir trabalhos de casa.");
    return;
  }

  if (!EstaDisfarcado())
  {
    cEmpregadaPastelaria.Say("Clientes nao entram na cozinha.");
    player.Say("E uma regra muito clara. Irritantemente clara.");
    return;
  }

  if (!empregadaDeixouPassar)
  {
    player.Say("Sou o novo ajudante.");
    cEmpregadaPastelaria.Say("Ah! Es tu?");
    player.Say("Foi uma decisao muito recente.");
    cEmpregadaPastelaria.Say("O chefe disse que hoje vinha alguem novo.");
    cEmpregadaPastelaria.Say("Entra depressa. Ele esta de pessimo humor matematico.");
    player.Say("Isso e pior do que o humor normal?");
    cEmpregadaPastelaria.Say("Tem mais angulos.");
    empregadaDeixouPassar = true;
  }

  enteredKitchen = true;
  player.ChangeRoom(7, 720, 500);
}

function room_Load()
{
  AtualizarEmpregada();
  oBanco.Clickable = false; // O hotspot hBanco trata das interacoes.
  if (bancoAlinhado)
  {
    oBanco.X = BANCO_DESTINO_X;
    oBanco.Y = BANCO_DESTINO_Y;
  }
  player.PlaceOnWalkableArea();
}

function room_AfterFadeIn()
{
  if (!introducaoVista && !pastelariaConcluida)
  {
    player.Say("Ola. Vim buscar o bolo do meu aniversario.");
    cEmpregadaPastelaria.Say("Ainda nao esta pronto.");
    player.Say("E uma frase arrojada para dizer a um aniversariante.");
    cEmpregadaPastelaria.Say("O ajudante faltou e o chefe ainda esta a acabar as coberturas.");
    introducaoVista = true;
  }
}

function OlharParaEmpregada()
{
  player.Say("A empregada consegue atender tres clientes e desconfiar de nenhum.");
}

function FalarComEmpregada()
{
  if (EstaDisfarcado()) TentarEntrarNaCozinha();
  else
  {
    player.Say("Posso ajudar o chefe?");
    cEmpregadaPastelaria.Say("So o novo ajudante pode entrar.");
    player.Say("Claro. O novo ajudante. Que certamente tem um avental e um chapeu.");
  }
}

function hBalcao_Look(Hotspot *theHotspot, CursorMode mode)
{
  player.Say("Bolos atras de vidro. Uma medida de seguranca sensata e cruel.");
}

function hBalcao_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.Say("Nao vou saltar o balcao. Ainda nao tenho seguro de trabalho.");
}

function hPortaCozinha_Look(Hotspot *theHotspot, CursorMode mode)
{
  player.Say("A porta da cozinha. Do outro lado esta o meu bolo e, aparentemente, a matematica.");
}

function hPortaCozinha_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TentarEntrarNaCozinha();
}

function hBanco_Look(Hotspot *theHotspot, CursorMode mode)
{
  if (bancoAlinhado) player.Say("O banco esta estrategicamente colocado sob o avental.");
  else player.Say("Um banco pequeno. Finalmente, mobiliario da minha categoria de peso.");
}

function hBanco_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (bancoAlinhado)
  {
    player.Say("Ja esta no sitio. Empurra-lo mais seria urbanismo.");
    return;
  }
  player.Walk(690, 460, eBlock, eWalkableAreas);
  oBanco.Move(BANCO_DESTINO_X, BANCO_DESTINO_Y, 2, eBlock, eAnywhere);
  bancoAlinhado = true;
  Display("Gabriel arrasta o banco para debaixo do avental.");
  player.Say("A geometria tambem serve para alinhar pequenos delitos.");
}

function hAvental_Look(Hotspot *theHotspot, CursorMode mode)
{
  if (temAvental) player.Say("Estou a usar o avental. Fica-me como uma tenda higienica.");
  else player.Say("Um avental branco, pendurado a uma altura discriminatoria.");
}

function hAvental_PickUp(Hotspot *theHotspot, CursorMode mode)
{
  if (temAvental)
  {
    player.Say("Ja o tenho vestido.");
    return;
  }
  if (!bancoAlinhado)
  {
    player.Say("Nao chego. Preciso de elevar a operacao.");
    return;
  }
  player.Walk(700, 455, eBlock, eWalkableAreas);
  temAvental = true;
  Display("Gabriel sobe ao banco e veste o avental.");
  player.Say("Agora pareco um ajudante muito pequeno ou um guardanapo muito ambicioso.");
  if (EstaDisfarcado()) Display("Disfarce de ajudante completo.");
}

function hAvental_Interact(Hotspot *theHotspot, CursorMode mode)
{
  hAvental_PickUp(theHotspot, mode);
}

function hChapeus_Look(Hotspot *theHotspot, CursorMode mode)
{
  player.Say("Chapeus descartaveis. Autoridade culinaria em papel fino.");
}

function hChapeus_PickUp(Hotspot *theHotspot, CursorMode mode)
{
  if (temChapeu)
  {
    player.Say("Um chapeu chega. Dois pareceriam uma sobremesa de casamento.");
    return;
  }
  temChapeu = true;
  Display("Gabriel coloca um chapeu de cozinha.");
  player.Say("Cabe perfeitamente, se ignorarmos a parte que me tapa as orelhas.");
  if (EstaDisfarcado()) Display("Disfarce de ajudante completo.");
}

function hChapeus_Interact(Hotspot *theHotspot, CursorMode mode)
{
  hChapeus_PickUp(theHotspot, mode);
}

function hSaida_Look(Hotspot *theHotspot, CursorMode mode)
{
  player.Say("A rua. La fora ha pessoas que acreditam que o meu bolo esta pronto.");
}

function hSaida_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (pastelariaConcluida) player.ChangeRoom(1, 400, 420);
  else player.Say("Nao saio sem o bolo. Um aniversario sem bolo e apenas uma reuniao com velas.");
}

function on_call(int value)
{
  if (value == 600) OlharParaEmpregada();
  else if (value == 601 || value == 602) FalarComEmpregada();
}
