// Room 7: cozinha da pastelaria (segunda metade da Room 6)

bool introducaoCozinhaVista = false;
bool introducaoAmpulhetasVista = false;

function MostrarBolos(bool visiveis)
{
  oBoloA.Visible = visiveis;
  oBoloB.Visible = visiveis;
  oBoloC.Visible = visiveis;
  oBoloD.Visible = visiveis;
  oBoloE.Visible = visiveis;
  oLivroEncomendas.Visible = visiveis;

  hBoloA.Enabled = visiveis;
  hBoloB.Enabled = visiveis;
  hBoloC.Enabled = visiveis;
  hBoloD.Enabled = visiveis;
  hBoloE.Enabled = visiveis;
  hLivroEncomendas.Enabled = visiveis;
}

function IniciarDesafioDoCartaz()
{
  if (cartazGregoResolvido) return;
  cPasteleiro.Say("Antes de comecares: sabes o que diz aquele cartaz?");
  dCartazGrego.Start();
}


function ResizeObject(Object *o,  int scale){
  o.ManualScaling = true;
  o.Scaling = scale;
}


function IniciarAmpulhetas()
{
  if (!cartazGregoResolvido || ampulhetasResolvidas) return;

  if (!introducaoAmpulhetasVista)
  {
    dIntroducaoAmpulhetas.Start();
    introducaoAmpulhetasVista = true;
    ResetHourglassPuzzle();
  }

  dAmpulhetas.Start();
}

function IniciarEscolhaDoBolo()
{
  if (!ampulhetasResolvidas || boloIdentificado) return;
  dEscolherBolo.Start();
}

function room_Load()
{
  player.ChangeView(14); // ViewGPasteleiro
  cPasteleiro.ChangeRoom(7, 90, 550);
  cPasteleiro.ManualScaling = true;
  cPasteleiro.Scaling = 95;  
  player.PlaceOnWalkableArea();
  ResizeObject(oAmpulheta4,50);
  ResizeObject(oAmpulheta7,50);
  ResizeObject(oLivroEncomendas, 50);
  ResizeObject(oBoloA, 35);
  ResizeObject(oBoloB, 35);
  ResizeObject(oBoloC, 35);
  ResizeObject(oBoloD, 35);
  ResizeObject(oBoloE, 35);
  ResizeObject(oCartazGrego, 50);

  MostrarBolos(ampulhetasResolvidas);
}

function room_AfterFadeIn()
{
  if (pastelariaConcluida)
  {
    player.Say("A cozinha sobreviveu. O chefe ainda esta a calcular os danos.");
    return;
  }

  if (!introducaoCozinhaVista)
  {
    player.Walk(300, 550, eBlock, eWalkableAreas);
    cPasteleiro.Say("Tu deves ser o novo ajudante.");
    player.Say("E a teoria mais conveniente neste momento.");
    cPasteleiro.Say("Es muito pequeno.");    
    player.Say("E' porque ainda estou em periodo experimental.");
    introducaoCozinhaVista = true;
  }

  if (!cartazGregoResolvido) IniciarDesafioDoCartaz();
  else if (ampulhetasResolvidas && !boloIdentificado) IniciarEscolhaDoBolo();
}

function OlharParaPasteleiro()
{
  player.Say("O chefe olha para uma tarte como se ela tivesse errado uma equacao.");
}

function FalarComPasteleiroDaCozinha()
{
  if (!cartazGregoResolvido) IniciarDesafioDoCartaz();
  else if (!ampulhetasResolvidas) IniciarAmpulhetas();
  else if (!boloIdentificado) dEscolherBolo.Start();
  else cPasteleiro.Say("O bolo esta resolvido. E uma frase que so aqui faz sentido.");
}

function hCartazGrego_Look(Hotspot *theHotspot, CursorMode mode)
{
  player.Say("Diz: 'Agheometretos medeis eisito'. O grego parece zangado mesmo quando e geometria.");
}

function hCartazGrego_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (!cartazGregoResolvido) IniciarDesafioDoCartaz();
  else player.Say("Que nao entre quem nao souber geometria. Ja entrei, portanto passei a parte pratica.");
}

function hAmpulhetas_Look(Hotspot *theHotspot, CursorMode mode)
{
  if (ampulhetasResolvidas) player.Say("Quatro mais sete, com voltas suficientes, deu nove e uma cobertura.");
  else ShowHourglassStatus();
}

function hAmpulhetas_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (!cartazGregoResolvido) player.Say("O chefe ainda me esta a examinar em grego.");
  else if (!introducaoAmpulhetasVista) player.Say("Antes de lhes mexer, e melhor perguntar ao chefe o que pretende.");
  else if (!ampulhetasResolvidas) player.Say("As ampulhetas fazem parte do desafio. Para continuar, tenho de falar com o chefe.");
  else player.Say("Nao volto a mexer. A matematica ja esta comestivel.");
}

function hForno_Look(Hotspot *theHotspot, CursorMode mode)
{
  if (cakeInOven) player.Say("A cobertura esta no forno ha exatamente o tempo que o chefe acaba de anunciar.");
  else player.Say("Um forno enorme. Parece capaz de assar um bolo e a respetiva demonstracao.");
}

function hForno_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (!introducaoAmpulhetasVista) player.Say("Nao vou ligar o forno sem saber o que o chefe quer cozer.");
  else if (!ampulhetasResolvidas) player.Say("O forno espera pelas instrucoes que escolho ao falar com o chefe.");
  else player.Say("A cobertura ja saiu perfeita. Reaquecer seria revisionismo.");
}

function hLivroEncomendas_Look(Hotspot *theHotspot, CursorMode mode)
{
  // Solucao unica validada: A=Mariana, B=Tiago, C=Rita, D=Gabriel, E=Patricia.
  player.Say("Os bolos estao alinhados da esquerda para a direita: A, B, C, D e E.");
  Display("PISTAS 1-3:\n\n1. O bolo da Patricia nao e quadrado.\n\n2. Mariana nao escolheu morango nem caramelo.\n\n3. O bolo do Tiago esta algures a esquerda do bolo com cerejas.");
  Display("PISTAS 4-6:\n\n4. O bolo da Rita esta algures entre o bolo com flores e o bolo do Gabriel.\n\n5. O bolo com estrelas nao e de Patricia nem de Mariana.\n\n6. O bolo do Gabriel nao e redondo nem oval.");
  Display("PISTAS 7-9:\n\n7. O bolo de chocolate negro nao e de Rita nem de Tiago.\n\n8. O bolo com futebol esta a esquerda do bolo do Tiago.\n\n9. O bolo da Patricia esta a direita do bolo do Gabriel.");
  player.Say("Isto nao e um livro de encomendas. E uma ameaca a comprar papel quadriculado.");
}

function hLivroEncomendas_Interact(Hotspot *theHotspot, CursorMode mode)
{
  hLivroEncomendas_Look(theHotspot, mode);
}

function DescreverBolo(int bolo)
{
  if (bolo == 1) player.Say("Bolo A: redondo, chocolate, decoracao de futebol.");
  else if (bolo == 2) player.Say("Bolo B: quadrado, baunilha sem chocolate, decorado com flores.");
  else if (bolo == 3) player.Say("Bolo C: retangular, morango com base de chocolate, decorado com cerejas.");
  else if (bolo == 4) player.Say("Bolo D: hexagonal, caramelo com recheio de chocolate, estrelas de acucar.");
  else player.Say("Bolo E: oval, chocolate negro, decorado com um oboe de acucar.");
}

function hBoloA_Look(Hotspot *theHotspot, CursorMode mode) { DescreverBolo(1); }
function hBoloB_Look(Hotspot *theHotspot, CursorMode mode) { DescreverBolo(2); }
function hBoloC_Look(Hotspot *theHotspot, CursorMode mode) { DescreverBolo(3); }
function hBoloD_Look(Hotspot *theHotspot, CursorMode mode) { DescreverBolo(4); }
function hBoloE_Look(Hotspot *theHotspot, CursorMode mode) { DescreverBolo(5); }

function hBoloA_Interact(Hotspot *theHotspot, CursorMode mode) { SelectBirthdayCake(1); }
function hBoloB_Interact(Hotspot *theHotspot, CursorMode mode) { SelectBirthdayCake(2); }
function hBoloC_Interact(Hotspot *theHotspot, CursorMode mode) { SelectBirthdayCake(3); }
function hBoloD_Interact(Hotspot *theHotspot, CursorMode mode) { SelectBirthdayCake(4); }
function hBoloE_Interact(Hotspot *theHotspot, CursorMode mode) { SelectBirthdayCake(5); }

function hPortaLoja_Look(Hotspot *theHotspot, CursorMode mode)
{
  player.Say("A porta para a loja. A empregada provavelmente ainda acredita no meu contrato.");
}

function hPortaLoja_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (pastelariaConcluida)
  {
    player.ChangeView(2);
    player.ChangeRoom(2, 400, 420);
  }
  else player.Say("Nao saio sem o bolo. O disfarce tem uma janela de credibilidade limitada.");
}

function on_call(int value)
{
  if (value == 700)
  {
    MostrarBolos(true);
  }
  else if (value == 710) OlharParaPasteleiro();
  else if (value == 711 || value == 712) FalarComPasteleiroDaCozinha();
}



