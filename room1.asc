function hSofa_PickUp(Hotspot *theHotspot, CursorMode mode)
{
  player.Say("Levar um sofa comigo seria um plano admiravel e totalmente irrealista.");
}

function oCup_PickUp(Object *theObject, CursorMode mode)
{
    player.AddInventory(iCup);
    oCup.Visible = false;
    Display("You pick up the cup.");

}

function oObject0_Look(Object *theObject, CursorMode mode)
{
  player.Say("Um objeto qualquer. O tipo de coisa que fica ali esperando ser importante.");
}

function oObject0_Interact(Object *theObject, CursorMode mode)
{
  player.Say("Eu mexo no objeto. Ele responde com o charme de um tijolo diplomata.");
}

function oObject0_AnyClick(Object *theObject, CursorMode mode)
{
theObject.Move(680, 80, 5, eBlock, eAnywhere);
theObject.Move(380, 180, 5, eBlock, eAnywhere);
}
