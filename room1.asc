function hDesenho_UseInv(Hotspot *theHotspot, CursorMode mode)
{
  if (player.ActiveInventory==iPistolL){
    player.Walk(hTapete.WalkToX,hTapete.WalkToY, eBlock, eAnywhere);    
    player.Say("Aqui vai disto!");
    player.ChangeView(NERFSHOOT);
    player.Animate(0,50 , eOnce, eNoBlock, eForwards);
    Wait(150);
    oNerfFly.Visible=true;
    oNerfFly.Move(400, 100, 2, eBlock, eAnywhere);
    oNerfFly.Move(400, 300, 2, eNoBlock, eAnywhere);
    oPartitura.Move(400, 300, 2, eBlock, eAnywhere);
    oPartitura.SetProperty("Pickable", true);   
    
    player.ChangeView(VIEW_WG);
  
}
}

function oPartitura_PickUp(Object *theObject, CursorMode mode)
{
if (theObject.GetProperty("Pickable")==false){
  player.Say("Esta muito alto, nao chego la");
}
else{
  
    player.Walk(theObject.X, theObject.Y);
  while(player.Moving==true) Wait(2);
  
  theObject.Visible=false;
  player.AddInventory(iPartitura);

}
}




