function oCup_PickUp(Object *theObject, CursorMode mode)
{
  if (oReed.Visible){
    player.Walk(theObject.X, theObject.Y);
    while(player.Moving==true) Wait(2);
    player.AddInventory(iReed);
    oReed.Visible = false;
    Display("Apanhaste a Palheta.");
  }
}

function oCup_Look(Object *theObject, CursorMode mode)
{
  player.Say("Uma caneca. Tem dentro uma palheta de oboe.");
  oReed.Visible=true;
}

function oCup_Interact(Object *theObject, CursorMode mode)
{
  player.Say("Eu mexo no objeto. Ele responde com o charme de um tijolo diplomata.");
}

function oObject0_AnyClick(Object *theObject, CursorMode mode)
{
theObject.Move(680, 80, 5, eBlock, eAnywhere);
theObject.Move(380, 180, 5, eBlock, eAnywhere);
}

function sofa_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.Say("Está qualquer coisa enfiada no sofá...");
  oNerfs.Visible=true;
}

function oNerfs_PickUp(Object *theObject, CursorMode mode)
{
player.AddInventory(iNerfs);
oNerfs.Visible=false;
Display("Apanhaste os Nerfs.");
}


function oObject1_PickUp(Object *theObject, CursorMode mode)
{
  player.Walk(theObject.X, theObject.Y);
  while(player.Moving==true) Wait(2);
  
theObject.Visible=false;
player.AddInventory(iPistol);

}

function oObject1_Look(Object *theObject, CursorMode mode)
