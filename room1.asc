function hLuzCabec_Look(Hotspot *thisHotspot, CursorMode mode)
{
  player.Say("Uma luz no teto. Vigia perfeita, fofoca profissional.");
}

function hLuzCabec_Interact(Hotspot *thisHotspot, CursorMode mode)
{
  player.Say("Eu mexo na luz, mas ela continua ali, julgando todo mundo em silencio.");
}

function hPorta_Look(Hotspot *thisHotspot, CursorMode mode)
{
  player.Say("Uma porta. O universo inventou isso para me contrariar.");
}

function hPorta_Interact(Hotspot *thisHotspot, CursorMode mode)
{
  player.Walk(thisHotspot.WalkToX, thisHotspot.WalkToY, eBlock, eWalkableAreas);
  player.Say("Mae?");
  cVania.Say("Mae: Gabriel, antes de te deitares tens de praticar o oboe.");

  if (gabriel_practiced_oboe)
  {
    player.Say("Eu ja pratiquei. A porta continua a nao ser a cama.");
  }
  else if (GabrielCanPractice())
  {
    player.Say("A partitura esta no tripe. Tenho de usar o oboe nela.");
  }
  else if (GabrielHasPracticeItems())
  {
    player.Say("Tenho o oboe e a partitura. Falta por a partitura no tripe.");
  }
  else if (player.InventoryQuantity[iOboeR.ID] > 0)
  {
    player.Say("O oboe esta pronto. Agora preciso da partitura no tripe.");
  }
  else
  {
    player.Say("Ainda me falta preparar o oboe e encontrar a partitura.");
  }
}

function hPorta_MouseMove(Hotspot *theHotspot)
{
  // A porta nao faz nada, mas continua me julgando em silencio.
}

function hPorta_PickUp(Hotspot *thisHotspot, CursorMode mode)
{
  player.Say("Porta no bolso era um conceito criativo demais para a realidade.");
}

function hBed_Look(Hotspot *theHotspot, CursorMode mode)
{
  player.Say("Uma cama. O unico lugar da sala que parece apoiar minhas decisoes.");
}

function hBed_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.Walk(theHotspot.WalkToX, theHotspot.WalkToY, eBlock, eWalkableAreas);

  if (!gabriel_practiced_oboe)
  {
    player.Say("Se me deito agora, a minha mae ativa o modo chefe final.");
    return;
  }

  player.Say("Agora sim. Cama.");
  player.ChangeRoom(2, 400, 400);
}

function hTripe_Look(Hotspot *theHotspot, CursorMode mode)
