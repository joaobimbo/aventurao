// room script file

bool GabrielHasPracticeItems()
{
  return (player.InventoryQuantity[iOboeR.ID] > 0 && player.InventoryQuantity[iPartitura.ID] > 0);
}

bool partitura_on_tripe = false;

bool GabrielCanPractice()
{
  return (player.InventoryQuantity[iOboeR.ID] > 0 && partitura_on_tripe);
}

function PutPartituraOnTripe()
{
  if (partitura_on_tripe)
  {
    player.Say("A partitura ja esta no tripe.");
    player.ActiveInventory = null;
    return;
  }

  player.Walk(hTripe.WalkToX, hTripe.WalkToY, eBlock, eAnywhere);
  player.PlaceOnWalkableArea();
  player.LoseInventory(iPartitura);
  player.ActiveInventory = null;
  partitura_on_tripe = true;

  oTripe.Graphic = 80;
  oTripe.Visible = true;

  player.Say("Pronto, partitura no sitio. Ja nao tenho desculpa.");
}

function PracticeOboe(bool advances_story)
{
  player.Walk(hTripe.WalkToX, hTripe.WalkToY, eBlock, eWalkableAreas);
  if (advances_story)
  {
    player.Say("Esta bem... so um bocadinho antes de dormir.");
  }
  else
  {
    player.Say("Mais uma vez. Pela arte. E para adiar dormir.");
  }

  player.ChangeView(4);
  player.Animate(0, 5, eOnce, eBlock, eForwards);
  player.ChangeView(VIEW_WG);

  if (advances_story)
  {
    gabriel_practiced_oboe = true;
    player.Say("Pronto. Pratiquei. Tecnicamente impecavel.");
  }
  else
  {
    player.Say("Ainda soa a oboe. Isso conta como progresso.");
  }
}

function TryUsePartituraOnTripe()
{
  if (player.ActiveInventory == iPartitura)
  {
    PutPartituraOnTripe();
    return;
  }

  if (player.ActiveInventory == iOboeR)
  {
    player.ActiveInventory = null;

    if (!partitura_on_tripe)
    {
      player.Say("Preciso da partitura no tripe antes de tocar.");
      return;
    }

    PracticeOboe(!gabriel_practiced_oboe);
    return;
  }

  player.Say("Isto nao pertence ao tripe.");
}

