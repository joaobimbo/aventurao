{
  player.Say("Porta no bolso era um conceito criativo demais para a realidade.");
}

function hBed_Look(Hotspot *theHotspot, CursorMode mode)
{
  player.Say("Uma cama. O unico lugar da sala que parece apoiar minhas decisoes.");
}

