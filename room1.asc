function hLuzCabec_Look(Hotspot *thisHotspot, CursorMode mode)
{
  player.Say("Uma luz no teto. Vigia perfeita, fofoca profissional.");
}

function hLuzCabec_Interact(Hotspot *thisHotspot, CursorMode mode)
{
  player.Say("Eu mexo na luz, mas ela continua ali, julgando todo mundo em silencio.");
}

function hPorta_Look(Hotspot *thisHotspot, CursorMode mode)
{
  player.Say("Uma porta. O universo inventou isso para me contrariar.");
}

function hPorta_Interact(Hotspot *thisHotspot, CursorMode mode)
{
  player.Say("Eu puxo a porta com toda a dignidade de um heroi infantil. Ela vence a discussao.");
}

